# Copy to .env and fill in your own values.
# Get a free API key at https://weatherstack.com
WEATHERSTACK_API_KEY=
WEATHERSTACK_QUERY=New York
WEATHERSTACK_UNITS=m

# Postgres (matches docker-compose.yaml defaults)
POSTGRES_DB=db
POSTGRES_USER=db_user
POSTGRES_PASSWORD=db_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
